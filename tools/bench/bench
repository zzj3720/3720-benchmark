#!/bin/sh
# Run the bench CLI with Harbor's interpreter so agent classes can be imported.
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
python=${BENCH_PYTHON:-$HOME/.local/share/uv/tools/harbor/bin/python}
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec "$python" -m tools.bench "$@"
