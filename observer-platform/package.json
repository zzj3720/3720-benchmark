{
  "name": "3720-observer-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "rm -rf dist && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "publish:local": "scripts/publish-local.sh",
    "qa:parabox:data": "cargo run --quiet --manifest-path ../games/parabox-intro/Cargo.toml --bin render-qa -- ../games/parabox-intro/data/campaign > public/parabox-render-qa-64.json",
    "qa:sausage:data": "cargo run --release --quiet --manifest-path ../games/sausage-roll/Cargo.toml --bin sausage-render-qa > public/sausage-render-qa-64.json",
    "qa:operator:data": "cargo run --quiet --manifest-path ../games/emergency-operator/Cargo.toml --bin render-qa > public/operator-render-qa.json",
    "qa:kitchen:data": "cargo run --quiet --manifest-path ../games/kitchen-terminal/Cargo.toml --bin kitchen-render-qa > public/kitchen-render-qa.json",
    "test": "npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.check.json --noEmit --incremental false",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-toggle": "^1.1.15",
    "drizzle-orm": "0.45.2",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.25.0",
    "mediabunny": "^1.55.7",
    "next": "16.2.6",
    "pixi.js": "^8.20.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "packageManager": "npm@12.0.1"
}
