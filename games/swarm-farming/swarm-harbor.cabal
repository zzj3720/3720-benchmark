cabal-version: 3.6
name: swarm-harbor
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple

executable swarm-harbor
  main-is: Main.hs
  hs-source-dirs: app
  default-language: GHC2021
  ghc-options:
    -O2
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N
  build-depends:
    aeson,
    base >=4.18 && <5,
    bytestring,
    containers,
    fused-effects,
    http-types,
    lens,
    mtl,
    text,
    transformers,
    wai,
    warp,
    yaml,
    swarm:swarm-engine,
    swarm:swarm-lang,
    swarm:swarm-scenario,
    swarm:swarm-util
