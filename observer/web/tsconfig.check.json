{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "three": [
        "./node_modules/@types/three"
      ],
      "three/*": [
        "./node_modules/@types/three/*"
      ],
      "three/addons/*": [
        "./node_modules/@types/three/examples/jsm/*"
      ]
    }
  }
}
